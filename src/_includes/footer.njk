{#
  The member count is written once, in _data/site.json, and substituted into
  the tagline here. It used to appear as literal text in 16 places across the
  pages — and had already drifted, with co-founder-matching.html claiming
  10,000+ members while every other page said 20,000+.
#}
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brand"><span class="dot"></span> NYC Fintech Women</div>
        <p>{{ nav.footer.tagline | replace("{memberCount}", site.memberCount.display + site.memberCount.plus) }}</p>
      </div>
      {%- for column in nav.footer.columns %}
      <div class="foot-col"><h4>{{ column.heading }}</h4><ul>{% for link in column.links %}<li><a href="{{ link.href | resolveUrl(site) | selfLink(selfPage) }}">{{ link.label }}</a></li>{% endfor %}</ul></div>
      {%- endfor %}
    </div>
    <div class="foot-bot"><span>{{ nav.footer.copyright }}</span><span>{{ nav.footer.builtWith }}</span></div>
  </div>
</footer>
